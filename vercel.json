{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/research.mjs": {
      "maxDuration": 300
    },
    "api/write.mjs": {
      "maxDuration": 300
    },
    "api/analyze.mjs": {
      "maxDuration": 300
    },
    "api/daily.mjs": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "10 21 * * *"
    },
    {
      "path": "/api/daily",
      "schedule": "10 22 * * *"
    },
    {
      "path": "/api/daily",
      "schedule": "10 23 * * *"
    },
    {
      "path": "/api/daily",
      "schedule": "10 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, x-research-token, x-publish-token, x-admin-token"
        }
      ]
    }
  ]
}
